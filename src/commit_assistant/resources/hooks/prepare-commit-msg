# 獲取 repository 根目錄
REPO_ROOT=$(git rev-parse --show-toplevel)
CONFIG_FILE="$REPO_ROOT/.commit-assistant/.commit-assistant-config"

# 若個人設定檔不存在，表示此開發者尚未啟用 commit-assistant，直接跳過
if [ ! -f "$CONFIG_FILE" ]; then
    exit 0
fi

source "$CONFIG_FILE"

# 檢查是否開啟自動撰寫 commit message 功能
if [ "$ENABLE_COMMIT_ASSISTANT" != "true" ]; then
    exit 0
fi

# 檢查 commit 類型，只有在創建新訊息時才觸發
# 使用 -m、-F、amend、merge 等方式已經帶有訊息時，不介入
source_type=$2
if [ "$source_type" != "" ]; then
    exit 0
fi

# 由 AI agent（Claude Code、Gemini CLI 等）發起的 commit 不介入，讓 agent 自行決定訊息
# 環境變數清單需與 utils/environment_utils.py 的 AGENT_ENV_VARS 保持一致
if [ -n "$CLAUDECODE" ] || [ -n "$AI_AGENT" ] || [ -n "$GEMINI_CLI" ] || [ -n "$CODEX_SANDBOX" ] || [ -n "$CURSOR_AGENT" ]; then
    exit 0
fi

# 沒有可用的終端機（IDE GUI、CI 等）時無法進行互動操作，直接跳過
if ! (: < /dev/tty) 2>/dev/null; then
    exit 0
fi

# 將輸入導向終端機，讓互動選單可以讀取使用者輸入
exec < /dev/tty

# 檢查是否有python環境
if ! command -v python &> /dev/null; then
    echo "Error: Python is not installed."
    exit 1
fi

# 檢查命令是否存在
if ! command -v commit-assistant &> /dev/null; then
    echo "Error: commit-assistant is not installed."
    exit 1
fi

# 執行自動撰寫 commit message 工具
commit-assistant commit --msg-file "$1" --repo-path "$REPO_ROOT"
exit_code=$?

# 根據返回值決定是否繼續
if [ $exit_code -ne 0 ]; then
    echo "Commit message generation failed"
    exit $exit_code
fi